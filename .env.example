# Скопировать в .env: его читают docker compose (подстановки ${...} и env_file) и процессы,
# запущенные с хоста (payment_service.ENV_FILE). Окружение shell важнее .env.

# PostgreSQL приложения: контейнер db читает POSTGRES_USER/PASSWORD/DB, приложение — все POSTGRES_*
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments
# Хост и порт для запуска с хоста (стенд публикует db на этом порту); внутри compose контейнеры
# ходят на db:5432. Если 5432 занят — задайте другой
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_ECHO_SQL=false
# Предел установки соединения с PostgreSQL в секундах (по умолчанию 10)
# POSTGRES_CONNECT_TIMEOUT=10
# lock_timeout соединений в мс — обязателен консьюмерам (consumer, notifier), задаётся в их
# окружении (compose)
# POSTGRES_LOCK_TIMEOUT_MS=20000

# PostgreSQL интеграционных тестов — контейнер db_for_tests профиля tests (правила те же);
# если TEST_POSTGRES_* не заданы, интеграционные тесты БД пропускаются
TEST_POSTGRES_USER=payments
TEST_POSTGRES_PASSWORD=payments
TEST_POSTGRES_DB=payments_test
TEST_POSTGRES_HOST=localhost
TEST_POSTGRES_PORT=5433

# RabbitMQ: учётные данные контейнера и URL для процессов с хоста; внутри compose relay и
# consumer получают amqp://...@rabbitmq:5672/. Management UI — http://localhost:15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Интеграционные тесты RabbitMQ — брокер стенда, временные очереди; без переменной пропускаются
TEST_RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# API (deployment/entrypoints/entrypoint_api.sh): порт на хосте, воркеры uvicorn
APP_PORT=8000
API_WORKER_COUNT=2

# Статический API-ключ (adapters/auth/settings.py): заголовок X-API-Key, не короче 16 символов.
# В production — сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_API_KEY=dev-api-key-change-me-0123456789

# Логирование (adapters/log/settings.py)
LOG_LEVEL=INFO

# Эмуляция платёжного шлюза (adapters/payment_gateway/settings.py): задержка ответа в секундах,
# доля отказов 0..1 (consumer в compose берёт её из окружения shell: PAYMENT_GATEWAY_FAILURE_RATE=1
# docker compose up -d consumer — все платежи failed), повторы при отказе (всего попыток, первая
# пауза; дальше удваивается). Худшее время шлюза = попытки × DELAY_MAX + паузы (18 с)
PAYMENT_GATEWAY_DELAY_MIN=2
PAYMENT_GATEWAY_DELAY_MAX=5
PAYMENT_GATEWAY_FAILURE_RATE=0.1
PAYMENT_GATEWAY_RETRY_ATTEMPTS=3
PAYMENT_GATEWAY_RETRY_BACKOFF=1

# Доставка webhook (adapters/webhook/settings.py): дедлайн попытки в секундах, повторы при
# недоступности получателя (всего попыток, первая пауза). Худшее время = попытки × TIMEOUT + паузы
WEBHOOK_TIMEOUT=5
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_BACKOFF=1

# Публикация событий платежей из outbox (adapters/payment_events/settings.py): обменник, ключи
# маршрутизации по типу события (совпадают с NEW_PAYMENTS_ROUTING_KEY и
# PROCESSED_PAYMENTS_ROUTING_KEY консьюмеров), дедлайн подтверждения публикации
PAYMENT_EVENTS_EXCHANGE=payments
PAYMENT_EVENTS_CREATED_ROUTING_KEY=payments.new
PAYMENT_EVENTS_PROCESSED_ROUTING_KEY=payments.processed
PAYMENT_EVENTS_PUBLISH_TIMEOUT=5
# Пауза опроса outbox, когда публиковать нечего (adapters/outbox_poller/settings.py);
# сколько событий публикуется одной транзакцией relay (launchers/config.py)
OUTBOX_POLLER_IDLE_INTERVAL=1
RELAY_BATCH_SIZE=100

# Консьюмер новых платежей (adapters/new_payments/settings.py): обменник, очередь, ключ,
# DLX и DLQ, дедлайн попытки (не меньше lock_timeout + худшее время шлюза — проверяется при
# старте), паузы и бюджет повторов при недоступности БД (по исчерпании процесс
# останавливается без подтверждения), дедлайн записи в DLQ, дедлайн ping
NEW_PAYMENTS_EXCHANGE=payments
NEW_PAYMENTS_QUEUE=payments.new
NEW_PAYMENTS_ROUTING_KEY=payments.new
NEW_PAYMENTS_DLX=payments.dlx
NEW_PAYMENTS_DLQ=payments.new.dlq
NEW_PAYMENTS_HANDLER_TIMEOUT=60
NEW_PAYMENTS_RETRY_BACKOFF=0.5
NEW_PAYMENTS_RETRY_BACKOFF_MAX=10
NEW_PAYMENTS_RETRY_BUDGET=120
NEW_PAYMENTS_DLQ_PUBLISH_TIMEOUT=5
NEW_PAYMENTS_PING_TIMEOUT=5

# Консьюмер уведомлений (adapters/processed_payments/settings.py): то же для очереди
# payments.processed; дедлайн попытки — не меньше lock_timeout + худшее время webhook
PROCESSED_PAYMENTS_EXCHANGE=payments
PROCESSED_PAYMENTS_QUEUE=payments.processed
PROCESSED_PAYMENTS_ROUTING_KEY=payments.processed
PROCESSED_PAYMENTS_DLX=payments.dlx
PROCESSED_PAYMENTS_DLQ=payments.processed.dlq
PROCESSED_PAYMENTS_HANDLER_TIMEOUT=60
PROCESSED_PAYMENTS_RETRY_BACKOFF=0.5
PROCESSED_PAYMENTS_RETRY_BACKOFF_MAX=10
PROCESSED_PAYMENTS_RETRY_BUDGET=120
PROCESSED_PAYMENTS_DLQ_PUBLISH_TIMEOUT=5
PROCESSED_PAYMENTS_PING_TIMEOUT=5
# Файл метки «жив» для healthcheck процессов relay, consumer и notifier — задаётся в compose
# HEARTBEAT_FILE=/tmp/consumer.alive

# Эхо-приёмник webhook (webhook_sink): порт на хосте. В webhook_url указывать адрес внутри сети
# compose — http://webhook_sink:8080/payments (localhost внутри контейнера notifier — он сам)
WEBHOOK_SINK_PORT=8081
